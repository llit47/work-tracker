[Unit]
Description=Work Tracker API and web interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=work-tracker
Group=work-tracker
WorkingDirectory=/opt/work-tracker/backend
EnvironmentFile=/etc/work-tracker/work-tracker.env
ExecStart=/opt/work-tracker/backend/.venv/bin/uvicorn app.main:app --host ${APP_HOST} --port ${APP_PORT}
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/work-tracker

[Install]
WantedBy=multi-user.target
