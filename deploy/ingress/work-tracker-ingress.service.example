[Unit]
ConditionPathExists=<STATE_DIR>/active.json
Description=Work Tracker isolated ingress (explicit activation only)
After=network-online.target work-tracker.service
Wants=network-online.target
Requires=work-tracker.service
PartOf=work-tracker.service

[Service]
Type=simple
Group=www-data
ExecStart=<NGINX_BIN> -e stderr -p <RUNTIME_DIR>/ -c <GENERATION_DIR>/nginx.conf
KillSignal=SIGQUIT
TimeoutStopSec=10
Restart=on-failure
RestartSec=2s
RuntimeDirectory=work-tracker-ingress
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=<RUNTIME_DIR>

[Install]
# Only 9B2 creates the .wants link after checks and real HA confirmation.
WantedBy=work-tracker.service
