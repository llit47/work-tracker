# Overlay on /etc/work-tracker/work-tracker.env in Phase 9 only.
# Keep DATABASE_URL and WEBHOOK_TOKEN unchanged. No new secret or migration.
INGRESS_PROFILE=split
BROWSER_ALLOWED_ORIGINS=https://<PUBLIC_HOSTNAME>
CORS_ORIGINS=
SESSION_COOKIE_SECURE=true
# Initially 0. After verified HTTPS: 300, then 86400, finally 31536000.
# Never includeSubDomains/preload for this rollout.
BROWSER_HSTS_SECONDS=0
