# Use a long, random value. This token is required for POST webhook requests.
WEBHOOK_TOKEN=change-me-to-a-long-random-secret
DATABASE_URL=sqlite:///./work_tracker.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Explicit exception for trusted LAN HTTP development. HTTPS MUST use true.
SESSION_COOKIE_SECURE=false
